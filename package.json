{
  "name": "myledja-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env.development src/main.ts",
    "start": "node dist/src/main.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:e2e": "vitest run --project e2e",
    "test:cov": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "openapi": "tsx scripts/openapi.ts",
    "openapi:check": "tsx scripts/openapi.ts --check",
    "migrate": "tsx --env-file-if-exists=.env.development scripts/migrate.ts",
    "seed:dev": "tsx --env-file=.env.development scripts/seed-dev.ts",
    "cases:check": "node scripts/cases-check.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:int && npm run test:e2e && npm run build && npm run cases:check && npm run openapi:check"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.1.2",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@node-rs/argon2": "2.2.2",
    "@simplewebauthn/server": "14.0.3",
    "fastify": "5.12.7",
    "jose": "6.2.12",
    "mongodb": "7.7.0",
    "nodemailer": "10.1.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@swc/core": "1.16.18",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.4"
  },
  "overrides": {
    "fastify": "5.12.7"
  }
}
