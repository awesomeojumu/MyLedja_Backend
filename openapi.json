{
  "openapi": "3.1.0",
  "info": {
    "title": "MyLedja API",
    "version": "0.1.0",
    "description": "Generated from the Zod contracts by `npm run openapi`. Do not edit. Amounts are strings of whole minor units (kobo). Errors use the Error schema."
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Development"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CodeSent": {
        "type": "object",
        "properties": {
          "codeExpiresInSeconds": {
            "type": "number",
            "const": 600
          },
          "resendAfterSeconds": {
            "type": "number",
            "const": 45
          }
        },
        "required": [
          "codeExpiresInSeconds",
          "resendAfterSeconds"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "retryAfterSeconds": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "GoogleLinkNeeded": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "const": "google_link_needed"
          },
          "message": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "retryAfterSeconds": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "email": {
            "type": "string"
          },
          "linkToken": {
            "type": "string",
            "description": "Send as `googleLinkToken` with a password sign-in to link Google."
          }
        },
        "required": [
          "code",
          "message",
          "email",
          "linkToken"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "env": {
            "type": "string",
            "enum": [
              "development",
              "staging",
              "production"
            ]
          }
        },
        "required": [
          "status",
          "env"
        ],
        "additionalProperties": false
      },
      "PublicConfig": {
        "type": "object",
        "properties": {
          "env": {
            "type": "string",
            "enum": [
              "development",
              "staging",
              "production"
            ]
          },
          "google": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "clientId": {
                "description": "Google's public OAuth client id, when set up.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "enabled",
              "clientId"
            ],
            "additionalProperties": false
          },
          "services": {
            "type": "object",
            "properties": {
              "bankConnections": {
                "type": "boolean"
              },
              "files": {
                "type": "boolean"
              },
              "ai": {
                "type": "boolean"
              }
            },
            "required": [
              "bankConnections",
              "files",
              "ai"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "env",
          "google",
          "services"
        ],
        "additionalProperties": false,
        "description": "Which optional services are on, so the app hides what is off (TECH-SPEC 2.3 rule 3). No secrets."
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresIn": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Seconds (900)."
          },
          "refreshToken": {
            "description": "Null when the refresh token was set as a cookie.",
            "type": [
              "string",
              "null"
            ]
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresIn",
          "refreshToken",
          "user"
        ],
        "additionalProperties": false
      },
      "Tokens": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresIn": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Seconds (900)."
          },
          "refreshToken": {
            "description": "Null when the refresh token was set as a cookie.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresIn",
          "refreshToken"
        ],
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "setupComplete": {
            "type": "boolean",
            "description": "False until Welcome is finished; the app opens Welcome."
          },
          "workspaceId": {
            "type": "string",
            "description": "The Personal workspace."
          },
          "workspaceName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "setupComplete",
          "workspaceId",
          "workspaceName"
        ],
        "additionalProperties": false
      },
      "Workspace": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "const": "personal"
          },
          "currency": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          },
          "weekStart": {
            "type": "string",
            "enum": [
              "monday",
              "sunday",
              "saturday"
            ]
          },
          "budgetStyle": {
            "type": "string",
            "enum": [
              "tracking",
              "envelope"
            ]
          },
          "setupComplete": {
            "type": "boolean"
          },
          "skippedSteps": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "editor",
              "viewer"
            ],
            "description": "The caller's role."
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "version": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "currency",
          "timeZone",
          "weekStart",
          "budgetStyle",
          "setupComplete",
          "skippedSteps",
          "role",
          "features",
          "version"
        ],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/v1/auth/google": {
      "post": {
        "operationId": "signInWithGoogle",
        "tags": [
          "Auth"
        ],
        "summary": "Continue with Google",
        "description": "A new email creates an account. An email that already has a password answers 409 google_link_needed; sign in once with the password and `googleLinkToken` to link. 404 google_off when Google sign-in is not set up.",
        "security": [],
        "parameters": [
          {
            "name": "X-Operation-Id",
            "in": "header",
            "required": true,
            "description": "A UUID made on the device. Retries reuse it, and the server runs the change once.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idToken": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "staySignedIn": {
                    "default": false,
                    "description": "Web only. When true the refresh token is set as an HttpOnly cookie and `refreshToken` comes back null. Phones send false and keep the token in Keychain or Keystore.",
                    "type": "boolean"
                  },
                  "deviceName": {
                    "description": "Shown in Settings › Security.",
                    "type": "string",
                    "maxLength": 100
                  }
                },
                "required": [
                  "idToken"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "The input was refused; `field` names the field and `message` can be shown beside it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the details are wrong",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not in a workspace you belong to",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GoogleLinkNeeded"
                }
              }
            }
          },
          "429": {
            "description": "Too many tries; wait `retryAfterSeconds`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/new-password": {
      "post": {
        "operationId": "newPassword",
        "tags": [
          "Auth"
        ],
        "summary": "Set a new password with a recovery code; signs out every device",
        "security": [],
        "parameters": [
          {
            "name": "X-Operation-Id",
            "in": "header",
            "required": true,
            "description": "A UUID made on the device. Retries reuse it, and the server runs the change once.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^\\d{6}$"
                  },
                  "newPassword": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 200
                  }
                },
                "required": [
                  "email",
                  "code",
                  "newPassword"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No content"
          },
          "400": {
            "description": "The input was refused; `field` names the field and `message` can be shown beside it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many tries; wait `retryAfterSeconds`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/recover": {
      "post": {
        "operationId": "recover",
        "tags": [
          "Auth"
        ],
        "summary": "Email a recovery code",
        "description": "Always answers 202, whether or not the email is known (P03-01).",
        "security": [],
        "parameters": [
          {
            "name": "X-Operation-Id",
            "in": "header",
            "required": true,
            "description": "A UUID made on the device. Retries reuse it, and the server runs the change once.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodeSent"
                }
              }
            }
          },
          "400": {
            "description": "The input was refused; `field` names the field and `message` can be shown beside it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many tries; wait `retryAfterSeconds`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "operationId": "refresh",
        "tags": [
          "Auth"
        ],
        "summary": "Get a new access token; the refresh token rotates",
        "description": "Needs the X-MyLedja-Client header. With the cookie, the Origin must be an allowed web address. Reusing an old refresh token signs out every session.",
        "security": [],
        "parameters": [
          {
            "name": "X-MyLedja-Client",
            "in": "header",
            "required": true,
            "description": "Any value. Proves the request came from the app, not another site.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refreshToken": {
                    "description": "Omit on web when using the cookie.",
                    "type": "string",
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tokens"
                }
              }
            }
          },
          "400": {
            "description": "The input was refused; `field` names the field and `message` can be shown beside it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the details are wrong",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/resend-code": {
      "post": {
        "operationId": "resendCode",
        "tags": [
          "Auth"
        ],
        "summary": "Send a new sign-up or recovery code",
        "description": "Always answers 202. A new code is sent at most every 45 seconds.",
        "security": [],
        "parameters": [
          {
            "name": "X-Operation-Id",
            "in": "header",
            "required": true,
            "description": "A UUID made on the device. Retries reuse it, and the server runs the change once.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "purpose": {
                    "default": "sign_up",
                    "type": "string",
                    "enum": [
                      "sign_up",
                      "recover"
                    ]
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodeSent"
                }
              }
            }
          },
          "400": {
            "description": "The input was refused; `field` names the field and `message` can be shown beside it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many tries; wait `retryAfterSeconds`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/sign-in": {
      "post": {
        "operationId": "signIn",
        "tags": [
          "Auth"
        ],
        "summary": "Sign in with email and password",
        "description": "Wrong details give 401 \"Email or password is wrong\". After five failures, 429 with retryAfterSeconds (60, growing). An unverified account gives 403 email_not_verified and a new code is sent.",
        "security": [],
        "parameters": [
          {
            "name": "X-Operation-Id",
            "in": "header",
            "required": true,
            "description": "A UUID made on the device. Retries reuse it, and the server runs the change once.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "staySignedIn": {
                    "default": false,
                    "description": "Web only. When true the refresh token is set as an HttpOnly cookie and `refreshToken` comes back null. Phones send false and keep the token in Keychain or Keystore.",
                    "type": "boolean"
                  },
                  "deviceName": {
                    "description": "Shown in Settings › Security.",
                    "type": "string",
                    "maxLength": 100
                  },
                  "googleLinkToken": {
                    "description": "From a google_link_needed answer.",
                    "type": "string",
                    "maxLength": 4000
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "The input was refused; `field` names the field and `message` can be shown beside it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the details are wrong",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many tries; wait `retryAfterSeconds`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/sign-out": {
