    "/v1/workspaces/{workspaceId}/setup": {
      "post": {
        "operationId": "finishSetup",
        "tags": [
          "Workspaces"
        ],
        "summary": "Finish Welcome",
        "description": "Saves the workspace name, week start and budget style, and marks setup complete. Accounts (with their opening balances) and categories are kept with the workspace and posted to the ledger when it ships (build plan B1.1 and B1.6), so the app sends them once. Sending setup again replaces what was kept.",
        "security": [
          {
            "bearer": []
          }
        ],
        "x-min-role": "admin",
        "parameters": [
          {
            "name": "workspaceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          {
            "name": "X-Operation-Id",
            "in": "header",
            "required": true,
            "description": "A UUID made on the device. Retries reuse it, and the server runs the change once.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "workspaceName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "currency": {
                    "type": "string",
                    "const": "NGN"
                  },
                  "weekStart": {
                    "type": "string",
                    "enum": [
                      "monday",
                      "sunday",
                      "saturday"
                    ]
                  },
                  "accounts": {
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "description": "A UUID v7 made on the device, so later records can refer to it offline.",
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "bank",
                            "cash",
                            "wallet",
                            "card",
                            "savings",
                            "investment",
                            "loan"
                          ]
                        },
                        "openingBalance": {
                          "type": "string",
                          "pattern": "^-?(0|[1-9]\\d{0,17})$",
                          "description": "Whole kobo. For a card or loan, what you owe, as a positive figure."
                        },
                        "openingDate": {
                          "type": "string",
                          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
                          "description": "YYYY-MM-DD in the workspace time zone."
                        }
                      },
                      "required": [
                        "name",
                        "type",
                        "openingBalance",
                        "openingDate"
                      ]
                    }
                  },
                  "categories": {
                    "maxItems": 200,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 60,
                          "description": "Starter-set key, or \"custom-<n>\" for your own."
                        },
                        "group": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 60
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 60
                        }
                      },
                      "required": [
                        "key",
                        "group",
                        "name"
                      ]
                    }
                  },
                  "budgetStyle": {
                    "type": "string",
                    "enum": [
                      "tracking",
                      "envelope"
                    ]
                  },
                  "monthlyTakeHome": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^-?(0|[1-9]\\d{0,17})$",
                        "description": "Whole minor units (kobo) as a string, for example \"1845000\" for ₦18,450.00."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "skippedSteps": {
                    "maxItems": 5,
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 5
                    },
                    "description": "Steps left for the Dashboard's Get started checklist (P04-02)."
                  }
                },
                "required": [
                  "workspaceName",
                  "currency",
                  "weekStart",
                  "accounts",
                  "categories",
                  "budgetStyle",
                  "monthlyTakeHome",
                  "skippedSteps"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "The input was refused; `field` names the field and `message` can be shown beside it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the details are wrong",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not in a workspace you belong to",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
