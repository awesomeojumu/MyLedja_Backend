                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/sign-up": {
      "post": {
        "operationId": "signUp",
        "tags": [
          "Auth"
        ],
        "summary": "Create an account and email a 6-digit code",
        "description": "Always answers 202, even if the email is already registered; that email is told it already has an account (P02-04).",
        "security": [],
        "parameters": [
          {
            "name": "X-Operation-Id",
            "in": "header",
            "required": true,
            "description": "A UUID made on the device. Retries reuse it, and the server runs the change once.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 200
                  },
                  "termsAccepted": {
                    "type": "boolean",
                    "const": true
                  }
                },
                "required": [
                  "name",
                  "email",
                  "password",
                  "termsAccepted"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodeSent"
                }
              }
            }
          },
          "400": {
            "description": "The input was refused; `field` names the field and `message` can be shown beside it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many tries; wait `retryAfterSeconds`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/verify-email": {
      "post": {
        "operationId": "verifyEmail",
        "tags": [
          "Auth"
        ],
        "summary": "Check the sign-up code; creates the Personal workspace and signs in",
        "security": [],
        "parameters": [
          {
            "name": "X-Operation-Id",
            "in": "header",
            "required": true,
            "description": "A UUID made on the device. Retries reuse it, and the server runs the change once.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^\\d{6}$"
                  },
                  "staySignedIn": {
                    "default": false,
                    "description": "Web only. When true the refresh token is set as an HttpOnly cookie and `refreshToken` comes back null. Phones send false and keep the token in Keychain or Keystore.",
                    "type": "boolean"
                  },
                  "deviceName": {
                    "description": "Shown in Settings › Security.",
                    "type": "string",
                    "maxLength": 100
                  }
                },
                "required": [
                  "email",
                  "code"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "The input was refused; `field` names the field and `message` can be shown beside it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many tries; wait `retryAfterSeconds`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
